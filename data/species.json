  {
    "id": "sp-0031",
    "name": "Winterberry",
    "scientific": "Ilex verticillata",
    "rank": "species",
    "hashtags": ["winterberry", "holly", "winterfruit"],
    "wikidata": "Q3487324",
    "gbif": "5414267",
    "inaturalist": "61119",
    "gloss": {
      "text": "<em>Ilex</em>, the Latin name of the holm oak, became the holly’s; <em>verticillata</em> means “whorled”, for the berries clustered close around the stem. Linnaeus first named it <em>Prinos verticillatus</em> (1753), the name Thoreau and the 1855 plate still use; Asa Gray moved it into the hollies in 1856."
    }
  },
